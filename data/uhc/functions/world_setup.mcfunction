# Sets up gamerules and Drehmal configurations
gamerule doImmediateRespawn true
gamerule doDaylightCycle true
gamerule doMobSpawning true
gamerule doMobLoot true
gamerule mobGriefing true
difficulty easy

## Drehmal specific settings
# Mythic abilities PVP on
trigger Settings set 2
# KeepInventory off
trigger Settings set 20
# Difficulty scaling to singleplayer
trigger Settings set 4